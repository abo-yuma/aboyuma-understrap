name: Build CSS & JS

on:
  pull_request:
    branches: [develop]
    paths:
      - "**.scss"
      - "**.js"
      - "package-lock.json"
  workflow_dispatch:

concurrency:
  group: "${{ github.workflow }}-${{ github.ref }}"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "18.x"
          cache: "npm"

      - run: npm ci
      - run: npm run copy-assets
      - run: npm run css
      - run: npm run js
